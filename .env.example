# Copie para .env.local — NUNCA commitar secrets reais

# Obrigatório em produção (≥ 32 caracteres aleatórios; defaults fracos são rejeitados)
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria-min-32

# Obrigatório em produção — cifragem TOTP (DISTINTO de AUTH_SECRET, ≥32)
ENCRYPTION_KEY=troque-por-outra-chave-longa-aleatoria-min-32

# Seeds de demo (admin/corretor/cliente)
# Em produção: DEVE estar false/ausente (fail-closed ignora true)
ENABLE_DEV_SEED=false
NEXT_PUBLIC_ENABLE_DEV_SEED=false

# Força banner de demonstração
NEXT_PUBLIC_DEMO_MODE=true

# Em produção, NÃO exponha OTP/reset token na resposta da API
# EXPOSE_OTP_IN_RESPONSE=false

# --- Supabase (cliente / browser — só anon/publishable) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NUNCA coloque service_role em NEXT_PUBLIC_*

# --- Supabase (server-only) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role — só servidor
# Sem DATABASE_URL, o app usa PostgREST + service_role para ih_users (dev/prod OK se keys corretas).

# --- Persistência auth (ImóvelHub) — OBRIGATÓRIO em produção ---
# Sem URL em prod → processo NÃO sobe / auth retorna 503 (fail-closed).
# Aplique supabase/migrations/* SOMENTE no schema ImóvelHub (não use MCP de outro produto).
# Preferir connection pooling (porta 6543) no Vercel.
# IMOVELHUB_DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-....pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-....pooler.supabase.com:6543/postgres
# DATABASE_SSL=false                 # só local sem SSL

# --- Redis / Upstash — OBRIGATÓRIO em produção (rate-limit + revogação) ---
# Sem Redis em prod → fail-closed (sem fallback memória em auth crítico).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# REDIS_URL=redis://default:pass@host:6379

# --- E-mail (OTP + reset) ---
# Em produção sem Resend: NÃO finge envio; conta fica pending_verification.
# EMAIL_PROVIDER=console             # só DEV
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM="ImóvelHub <noreply@seu-dominio.com>"

# --- 2FA Super Admin ---
# Em produção: default ON (REQUIRE_ADMIN_2FA implícito). Sem sessão completa antes do TOTP.
# REQUIRE_ADMIN_2FA=true
# REQUIRE_ADMIN_2FA=false            # só emergências — não recomendado

# Skip assert em pipelines de build sem secrets (não usar em runtime prod)
# SKIP_PROD_ENV_ASSERT=true
